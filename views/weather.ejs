<!--This file is located at views/weather.js-->
<!DOCTYPE html>
<html>
<head>
  <title>Weather for <%= location %></title>
  <link rel="stylesheet" href="css/style.css">

</head>
<body>
  <h1>Weather in <%= location %></h1>
  
  <div class="weather-card">
    <p>🌡️ Temperature: <%= current.temperature %>°C</p>
    <p>🌦️ Conditions: <%= current.weather_descriptions[0] %></p>
    <p>💧 Humidity: <%= current.humidity %>%</p>
    <p>💨 Wind: <%= current.wind_speed %> km/h</p>
    <% if (current.uv_index) { %>
      <p>☀️ UV Index: <%= current.uv_index %></p>
    <% } %>
  </div>

  <!-- Packing Suggestions Section -->
  <div class="packing-section">
    <h2 class="packing-header">Packing Suggestions</h2>
    
    <% if (packing.length) { %>
      <% packing.forEach(group => { %>
        <div class="suggestion-group">
          <div class="suggestion-reason">👉 <%= group.reason %></div>
          <div class="suggestion-items">
            <% group.items.forEach(item => { %>
              <div class="suggestion-item"><%= item %></div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p>No specific packing suggestions for this weather.</p>
    <% } %>
  </div>

  <a href="/">Search again</a>
</body>
</html>
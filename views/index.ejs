<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Travel Weather Planner</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Base styles */
    :root {
      --primary-blue: #3498DB;
      --light-blue: #AED6F1;
      --dark-blue: #2C3E50;
      --accent-yellow: #F1C40F;
      --accent-green: #2ECC71;
      --accent-red: #E74C3C;
      --light-gray: #ECF0F1;
      --medium-gray: #BDC3C7;
      --dark-gray: #7F8C8D;
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Open Sans', sans-serif;
      line-height: 1.6;
      color: #333;
      background: linear-gradient(135deg, var(--light-blue), #ffffff);
      min-height: 100vh;
      padding: 20px;
    }
    
    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
    }
    
    /* Header styles */
    header {
      text-align: center;
      margin-bottom: 30px;
      padding: 20px 0;
    }
    
    h1 {
      font-family: 'Roboto Condensed', sans-serif;
      color: var(--dark-blue);
      font-size: 2.5rem;
      margin-bottom: 10px;
      background: linear-gradient(to right, var(--primary-blue), var(--accent-green));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    
    .subtitle {
      color: var(--dark-gray);
      font-size: 1.2rem;
      margin-bottom: 20px;
    }
    
    /* Card styles */
    .card {
      background-color: white;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      padding: 25px;
      margin-bottom: 25px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    }
    
    .card-header {
      color: var(--dark-blue);
      border-bottom: 2px solid var(--primary-blue);
      padding-bottom: 15px;
      margin-bottom: 20px;
      font-family: 'Roboto Condensed', sans-serif;
      font-size: 1.5rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    /* Form styles */
    .search-form {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    
    label {
      font-weight: 600;
      color: var(--dark-blue);
      font-size: 1.1rem;
    }
    
    input[type="text"] {
      padding: 12px 15px;
      border: 2px solid var(--medium-gray);
      border-radius: 8px;
      font-size: 1rem;
      transition: border-color 0.3s;
    }
    
    input[type="text"]:focus {
      outline: none;
      border-color: var(--primary-blue);
      box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.2);
    }
    
    button {
      background: linear-gradient(to right, var(--primary-blue), var(--accent-green));
      color: white;
      border: none;
      padding: 14px 25px;
      border-radius: 8px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }
    
    button:hover {
      transform: translateY(-3px);
      box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
    }
    
    button:active {
      transform: translateY(1px);
    }
    
    /* Features section */
    .features-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-top: 30px;
    }
    
    .feature-card {
      background-color: white;
      border-radius: 8px;
      padding: 20px;
      text-align: center;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
      border-top: 4px solid var(--primary-blue);
      transition: transform 0.3s;
    }
    
    .feature-card:hover {
      transform: translateY(-5px);
    }
    
    .feature-icon {
      font-size: 2.5rem;
      margin-bottom: 15px;
      color: var(--primary-blue);
    }
    
    .feature-title {
      font-family: 'Roboto Condensed', sans-serif;
      color: var(--dark-blue);
      margin-bottom: 10px;
      font-size: 1.3rem;
    }
    
    .feature-description {
      color: var(--dark-gray);
      font-size: 0.95rem;
    }
    
    /* Footer */
    footer {
      text-align: center;
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid var(--medium-gray);
      color: var(--dark-gray);
    }
    
    .nav-links {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 15px;
    }
    
    .nav-links a {
      color: var(--primary-blue);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.3s;
    }
    
    .nav-links a:hover {
      color: var(--accent-green);
      text-decoration: underline;
    }
    
    /* Responsive design */
    @media (max-width: 600px) {
      .container {
        padding: 15px;
      }
      
      h1 {
        font-size: 2rem;
      }
      
      .card {
        padding: 20px;
      }
      
      .features-container {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>🌍 Travel Weather Planner</h1>
      <p class="subtitle">Plan your trips with real-time weather forecasts and smart packing suggestions</p>
    </header>
    
    <main>
      <div class="card">
        <div class="card-header">
          <span>📍</span> Find Your Destination Weather
        </div>
        
        <form class="search-form" action="/search" method="POST">
          <div class="form-group">
            <label for="location">Enter Destination:</label>
            <input type="text" id="location" name="location" placeholder="e.g., Paris, Tokyo, New York" required>
          </div>
          
          <button type="submit">
            <span>🔍</span> Get Weather Forecast
          </button>
        </form>
      </div>
      
      <div class="features-container">
        <div class="feature-card">
          <div class="feature-icon">🌦️</div>
          <h3 class="feature-title">Real-Time Weather</h3>
          <p class="feature-description">Get up-to-date weather information for any location worldwide</p>
        </div>
        
        <div class="feature-card">
          <div class="feature-icon">🧳</div>
          <h3 class="feature-title">Smart Packing</h3>
          <p class="feature-description">Personalized packing suggestions based on weather conditions</p>
        </div>
        
        <div class="feature-card">
          <div class="feature-icon">🗺️</div>
          <h3 class="feature-title">Location Insights</h3>
          <p class="feature-description">Detailed geographic information for better trip planning</p>
        </div>
      </div>
    </main>
    
    <footer>
      <p>Plan your perfect trip with confidence</p>
      <div class="nav-links">
        <a href="/trips">View Saved Trips</a>
        <a href="/about">About This Project</a>
        <a href="/contact">Contact Us</a>
      </div>
    </footer>
  </div>
</body>
</html>